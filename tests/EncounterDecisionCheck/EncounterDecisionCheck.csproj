<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BmrDll Condition="'$(BmrDll)' == ''">../../BossMod/bin/Release/BossModReborn.dll</BmrDll>
    <DalamudDir Condition="'$(DalamudDir)' == ''">$(AppData)/XIVLauncher/addon/Hooks/dev</DalamudDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BossModReborn"><HintPath>$(BmrDll)</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(DalamudDir)/Dalamud.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(DalamudDir)/Dalamud.Bindings.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lumina"><HintPath>$(DalamudDir)/Lumina.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudDir)/Lumina.Excel.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
